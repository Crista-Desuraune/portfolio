---
import Layout from '../layouts/Layout.astro';
import FeaturedPosts from '../components/FeaturedPosts.astro';
import config from '../data/navigation.json';
import TagsList from '../components/TagsList.astro';
import Filter from '../components/ui/Filter.astro';

const { projects } = config.posts;

---
<Layout>
    <h1>Pour mes projets...</h1>
    <h2 class="text-foreground dark:text-background text-base font-normal font-base text-center mt-0 mb-5">Vous pouvez retrouver dans ces rubriques les projets que j’ai réalisés jusqu’à présent, allant des plus artistiques aux plus complexes.</h2>
    <div class="flex flex-col gap-2">
        <div id="icon" class="flex gap-2 cursor-pointer justify-start items-center">
            <Filter />
            <p>Filtre</p>
        </div>
        <div class="self-center">
            <TagsList id="list"/>
        </div>
    </div>
    
    <script>
        const list = document.querySelector('#list');
        const icon = document.querySelector('#icon');
            if (list && icon) {
            icon.addEventListener('click', () => {
                list.classList.toggle('hidden');
            });
        }
    </script>
    <FeaturedPosts postIds={projects} description="" />
</Layout>

