---
import Carousel from '../components/Carousel.astro';
import Section from '../components/Section.astro';
import Layout from '../layouts/Layout.astro';

const carouselOneData=[
    {imageSrc:"/images/rachid/rachid1.jpg", imageAlt:"carousel-rachid1"},
    {imageSrc:"/images/rachid/rachid2.jpg", imageAlt:"carousel-rachid2"},
    {imageSrc:"/images/rachid/rachid3.jpg", imageAlt:"carousel-rachid3"},
    {imageSrc:"/images/rachid/rachid4.jpg", imageAlt:"carousel-rachid4"},
    {imageSrc:"/images/rachid/rachid5.jpg", imageAlt:"carousel-rachid5"},
    {imageSrc:"/images/rachid/rachid6.jpg", imageAlt:"carousel-rachid6"},
    {imageSrc:"/images/rachid/rachid7.jpg", imageAlt:"carousel-rachid7"},
    {imageSrc:"/images/rachid/rachid8.jpg", imageAlt:"carousel-rachid8"},
]

const carouselTwoData=[
    {imageSrc:"/images/ces/ces1.png", imageAlt:"carousel-club-eco-st-sever1"},
    {imageSrc:"/images/ces/ces2.png", imageAlt:"carousel-club-eco-st-sever2"},
    {imageSrc:"/images/ces/ces3.png", imageAlt:"carousel-club-eco-st-sever3"},
    {imageSrc:"/images/ces/ces4.png", imageAlt:"carousel-club-eco-st-sever4"},
    {imageSrc:"/images/ces/ces5.png", imageAlt:"carousel-club-eco-st-sever5"},
    {imageSrc:"/images/ces/ces6.png", imageAlt:"carousel-club-eco-st-sever6"},
    {imageSrc:"/images/ces/ces7.png", imageAlt:"carousel-club-eco-st-sever7"},
    {imageSrc:"/images/ces/ces8.png", imageAlt:"carousel-club-eco-st-sever8"},
    {imageSrc:"/images/ces/ces9.png", imageAlt:"carousel-club-eco-st-sever9"},
    {imageSrc:"/images/ces/ces10.png", imageAlt:"carousel-club-eco-st-sever10"},
    {imageSrc:"/images/ces/ces11.png", imageAlt:"carousel-club-eco-st-sever11"},
    {imageSrc:"/images/ces/ces12.png", imageAlt:"carousel-club-eco-st-sever12"},
]
---
<Layout>
    <Carousel dimensions="w-lg" items={carouselOneData}/>
    <Carousel dimensions="w-xl" items={carouselTwoData}/>

    <Section sideImg="/images/logo-crista-275.png" sideAlt="alt-image-logo">
        <h1 class="text-3xl font-bold mb-5">À propos de moi</h1>
        <p class="text-base text-foreground">
            Je suis un développeur web passionné par la création d'expériences numériques uniques. Mon parcours m'a permis d'acquérir une solide expertise dans le développement front-end et back-end, ainsi que dans la conception d'interfaces utilisateur intuitives.
        </p>
    </Section>
    <Section reverse={true} sideImg="/images/logo-handisup.png" sideAlt="alt-image-logo">
        <h1 class="text-3xl font-bold mb-5">À propos de moi</h1>
        <p class="text-base text-foreground">
            Je suis un développeur web passionné par la création d'expériences numériques uniques. Mon parcours m'a permis d'acquérir une solide expertise dans le développement front-end et back-end, ainsi que dans la conception d'interfaces utilisateur intuitives.
        </p>
    </Section>
</Layout>