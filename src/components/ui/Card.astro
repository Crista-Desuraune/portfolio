---
import Button from './Button.astro';
const { cardsImage, cardsTitle, cardsDescription, cardsUrl } = Astro.props;
---
<div class="transition hover:-translate-y-2 duration-700 ease-in-out flex flex-col gap-4 rounded-lg bg-primary dark:bg-primary-accent p-5 w-auto font-base border-1 drop-shadow-lg/20 hover:drop-shadow-xl/70 border-primary-accent text-center">
  <div class="bg-background  border-1 drop-shadow-lg/20 border-primary-accent/10 p-3 w-full h-32 rounded-lg">
    <img src={cardsImage} alt="image" class="size-full w-auto justify-self-center items-center">
    
  </div>

  <h2 class="text-primary-foreground text-2xl font-bold font-heading"> {cardsTitle}</h2>

  <p class="font-base text-primary-foreground text-md line-clamp-2">
    {cardsDescription}
  </p>
  <Button variant="default" size="small" class="mt-auto self-center" aria-label=`Voir le projet ${cardsTitle}` href={cardsUrl}>
    Voir
  </Button>
</div>