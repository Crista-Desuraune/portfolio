---
const { dimensions } = Astro.props;
---

<div class="flex mx-auto my-5">
    <button class="prev p-3.5 text-6xl text-primary-accent/70 hover:text-primary-accent duration-200 ease-in-out inline">&#10096</button>
    <div id="carousel" class={`border-2 ${dimensions} border-primary-accent overflow-hidden flex flex-row relative`}>
        <slot />
    </div>
    <button class="next p-3.5 text-6xl text-primary-accent/70 hover:text-primary-accent duration-200 ease-in-out">&#10097</button>
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const carousel = document.querySelector('#carousel');
            const nextButton = document.querySelector('.next');
            const prevButton = document.querySelector('.prev');

            if (!carousel) {
                console.error('Carousel element not found!');
                return;
            }

            nextButton?.addEventListener('click', () => {
                carousel.scrollBy({
                    top: 0,
                    left: carousel.clientWidth,
                    behavior: 'smooth'
                });
            });

            prevButton?.addEventListener('click', () => {
                carousel.scrollBy({
                    top: 0,
                    left: -carousel.clientWidth,
                    behavior: 'smooth'
                });
            });
        });
    </script>
</div>