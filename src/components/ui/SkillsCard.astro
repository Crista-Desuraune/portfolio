---
import Config from '../../data/skills.json';

const { skill, tools } = Config;
const { skillsItems, title } = Astro.props;

type SkillsType = {
    label: string;
    img: string;
};
const competences = skillsItems
---
{skillsItems &&
<div class="container mx-auto text-center py-10">
    <h2 class="text-3xl font-bold mb-5">{title}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        {skillsItems.map((item:SkillsType) => (
            <div class="border-secondary-accent shadow-secondary-accent text-foreground p-5 rounded-lg shadow-lg">
                <h3 class="text-xl font-semibold pb-1.5">{item.label}</h3>
                <img src={item.img} alt={`logo-${item.label}`} class="size-16 w-auto mx-auto" />
            </div>
        ))}
    </div>
</div>
}