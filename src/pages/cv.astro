---
import CvCircle from '../components/CvCircle.astro';
import Section from '../components/Section.astro';
import SkillsCard from '../components/ui/SkillsCard.astro';
import Layout from '../layouts/Layout.astro';
import Data from "../data/infoGeneral.json";
import Config from '../data/skills.json';
import CvContent from '../components/ui/CvContent.astro';
import HorizontalLine from '../components/ui/HorizontalLine.astro'
import Button from '../components/ui/Button.astro';

const { skill, tools } = Config;

const { mail, phone, address } = Data.contact;
const socials = Data.social;

const primaryColor = "bg-primary text-background dark:bg-primary-accent dark:text-primary-foreground";
const primaryColorButton = "text-primary-foreground hover:text-background/70 dark:hover:text-background/70";

const secondaryColor = "bg-secondary text-foreground dark:bg-secondary-accent dark:text-secondary-foreground";
const secondaryColorButton = "text-foreground hover:text-foreground/70 dark:text-secondary-foreground dark:hover:text-secondary-foreground/70";
---

<Layout>
    <h1>Crista Desuraune--Cocu</h1>
    <h2 class="font-base dark:text-background font-bold text-center text-foreground text-[28px]">Développeuse Web</h2>
    <p class="rounded-lg dark:text-background font-bold text-foreground text-lg hover:shadow-primary dar:hover:shadow-primary-accent transition hover:-translate-y-1 duration-700 ease-in-out hover:shadow-2xl font-base justify-self-center mt-5 px-10 py-2.5 text-center w-3xl">Je suis à la recherche d'une alternance en tant que développeuse web à partir de septembre 2025</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-15 mt-15 items-center justify-items-center">

        <CvCircle titleCircle="Mes Coordonnées" colorPage={primaryColor} colorCircle={primaryColor} returnButton={primaryColorButton}>
            <div class="flex flex-col gap-6 items-center mt-40">
                <div class="flex gap-2 items-center">
                    <img src="/images/appel-telephonique.png" alt="telephone" class="size-10">
                    <p class="text-xl">
                        : {phone}
                    </p>
                </div>
                <div class="flex gap-2 items-center">
                    <img src="/images/enveloppe.png" alt="email" class="size-10">
                    <p class="text-xl">
                        : {mail}
                    </p>
                </div>
                <div class="flex gap-2 items-start w-xl">
                    <img src="/images/marqueur.png" alt="localisation" class="size-10">
                    <p class=" text-end text-xl">
                        : {address}
                    </p>
                </div>
            </div>
        </CvCircle>

        <CvCircle titleCircle="Langues" colorPage={secondaryColor} colorCircle={secondaryColor}  returnButton={secondaryColorButton}>
            <div class="flex flex-col gap-6 items-center mt-30">
                <div class="flex gap-4 items-center">
                    <img src="/images/flag-france.png" alt="drapeau de la france" class="size-20">
                    <p class="text-2xl">
                        Français
                    </p>
                </div>
                <div class="flex gap-4 items-center">
                    <p class="text-3xl">B1</p>
                    <img src="/images/flag-england.png" alt="drapeau de l'angletterre" class="size-20">
                    <p class="text-2xl"> 
                        Anglais
                    </p>
                </div>
                <div class="flex gap-5 items-center">
                    <p class="text-3xl">A2</p>
                    <img src="/images/flag-spain.png" alt="drapeau de l'espagne" class="size-20">
                    <p class="text-2xl">
                        Espagnol
                    </p>
                </div>
            </div>
        </CvCircle>

        <CvCircle titleCircle="Centres d'intérêt" colorPage={primaryColor} colorCircle={primaryColor} returnButton={primaryColorButton} >
            <h2 class="font-heading text-2xl text-primary-foreground">cv3</h2>
        </CvCircle>

        <CvCircle titleCircle="Compétences" colorPage={secondaryColor} colorCircle={secondaryColor}  returnButton={secondaryColorButton} >
            <div class="flex gap-4">
                <SkillsCard title="Mes compétences" skillsItems={skill}/>
                <SkillsCard title="Mes outils" skillsItems={tools}/>
            </div>
        </CvCircle>

        <CvCircle titleCircle="Formations" colorPage={primaryColor} colorCircle={primaryColor} returnButton={primaryColorButton} >
            <Section sideImg="/images/NWS-blanc.png" sideAlt="logo-normandie-web-school" sideSize="size-54 w-auto self-center">
                <CvContent title="Bachelor cheffe de projets digitaux" place="Normandie Web School - Rouen" date="2024-2027">
                    <li>Communication graphique et digital</li>
                    <li>Intégration web</li>
                    <li>Charte graphique</li>
                    <li>Wordpress</li>
                    <li>Développement Web</li>
                </CvContent>
	        </Section>
            <HorizontalLine/>
            <Section reverse="true" sideImg="/images/casquette-de-graduation.png" sideAlt="icone-diplôme" sideSize="size-64 h-auto" >
                <CvContent title="DIPLÔME BAFA" place="Céméa - Brémontier-Merval/Darnétal" date="2023-2025">
                    <li>Approfondissement: Accueuil en centre de loisirs</li>
                </CvContent>
	        </Section>
            <HorizontalLine/>
            <Section sideImg="/images/photo-lycee.jpg" sideAlt="lycée-delamare-deboutteville" sideSize="size-96 h-auto">
                <CvContent title="Baccalauréat général nsi et llce" place="Lycée Delamare Deboutteville - Forges-les-Eaux" date="2021-2024">
                    <li>Numérique et Sciences de l'Informatique</li>
                    <li>Langues, Littérature et Cultures Étrangères</li>
                </CvContent>
	        </Section>
        </CvCircle>

        <CvCircle titleCircle="Expériences Professionnelles" colorPage={secondaryColor} colorCircle={secondaryColor}  returnButton={secondaryColorButton} >
            <CvContent title="STAGE" place="Raphael Sanchez Design - Rouen" date="10 Mars 2025- 20 Juin 2025" secondaryTextColor="true">
                <li>Frontend</li>
                <li>GitHub utilisé en équipe</li>
                <li>Wordpress</li>
                <li>PHP</li>
            </CvContent>
            <HorizontalLine/>
            <CvContent reverse="true" title="PROJET HANDISUP" place="Normandie Web School - Rouen" date="13 Janvier 2025 - 14 Février 2025" secondaryTextColor="true">
                <li> Refonte du site web de l’association Handisup (wordpress, maquette figma)</li>
            </CvContent>
            <HorizontalLine/>
            <CvContent title="PORTFOLIO" place="Rouen" date="début Janvier 2025 - 4 Mars 2025" secondaryTextColor="true">
                <li>Création d’un site web portfolio en HTML/CSS et JavaScript (Actuellement en refonte)</li>
            </CvContent>
            <HorizontalLine/>
            <CvContent reverse="true" title="PROJET CLUB ECO SAINT SEVER" place="Normandie Web School - Rouen" date="14 octobre 2024 - 30 octobre 2024" secondaryTextColor="true">
                <li>Création d’une charte graphique pour un club d’entreprises du quartier de Saint Sever</li>
            </CvContent>
            <HorizontalLine/>
            <CvContent title="animatrice" place="Crèches Liberty - Gournay-en-Bray" date="2024-2025" secondaryTextColor="true">
                <li>Accueil des enfants en centre de loisirs</li>
            </CvContent>
        </CvCircle>
    </div>
    <div class="mt-10 flex justify-between items-center">
       
        <div class="size-96 h-auto flex">
            {socials.map((item) => (
                <div class="flex flex-col">
                    <a href={item.url} target="_blank" aria-label={`Retrouvez moi sur ${item.label}`}>
                        <img src={`/images/qrcode${item.icon}.png`} alt={`qr-code-${item.label}`} />
                    </a>
                    <p class="font-base text-center">{item.label}</p> 
                </div>
            ))}
        </div>
        <Button variant="primary" size="small" class="font-heading h-10" href="../images/cv-crista-desuraune-cocu.pdf" download="cv-crista-desuraune-cocu.pdf">
            Télécharger le CV
        </Button>
    </div>
      
</Layout>