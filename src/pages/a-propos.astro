---
import Layout from '../layouts/Layout.astro';
import FeaturedPosts from '../components/FeaturedPosts.astro';
import config from '../data/navigation.json';

const { about } = config.posts;
---
<Layout>
    <h1>Pour me présenter</h1>
    <FeaturedPosts postIds={about} description="Vous pouvez retrouver dans ces rubriques des éléments clés pour mieux comprendre qui je suis."/>
</Layout>