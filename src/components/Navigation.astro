---
import siteConfig from '../data/navigation.json';
const { primary } = siteConfig;

type LinkPrimaryType = {
  url: string;
  label: string;
};
---
<nav class="absolute inset-x-4 top-full z-2 lg:static">
  <div
    class="top-10 hidden flex-col gap-10 rounded-2xl border border-gray-300 bg-neutral-50 px-4 py-8 text-center md:p-0 lg:flex lg:flex-row lg:gap-10 lg:border-none"
  >
    {
        primary &&
        primary.map((item: LinkPrimaryType) => (
            <a
            class="hover:text-foreground-accent text-foreground block cursor-pointer text-base leading-7 underline"
            href={item.url}
            >
            {item.label}
            </a>
        ))
    }
  </div>
</nav>