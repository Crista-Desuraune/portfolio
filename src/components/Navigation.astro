---
import config from '../data/navigation.json';
import NavLink from './NavLink.astro';

const { primary } = config;

import type { LinkPrimaryType } from "../types";

---
<nav class="" role="navigation" aria-label="Navigation principale">
  <div
    class="hidden lg:flex text-primary-foreground gap-10"
  >
    {
        primary &&
        primary.map((item: LinkPrimaryType) => (
            <NavLink
                url={item.url}
                title={item.label}
            />
        ))
    }
  </div>
</nav>