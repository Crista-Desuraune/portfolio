---
import { cn } from '../../lib/utils';

// Types
export type ButtonType = 'button' | 'a';

export type ButtonPropsType = {
  default?: string;
  variant?: 'default' | 'primary' | 'secondary';
  size?: 'small' | 'medium' | 'large';
  class?: string;
  href?: string;
};

// Récupération des props
const {
  variant = 'default',
  size = 'medium',
  class: className,
  href,
  ...rest
}: ButtonPropsType = Astro.props;

// Styles de base
const baseStyles =
  'cursor-pointer font-base text-lg block rounded w-auto duration-250 ease-in-out no-underline my-2.5 ';

// Styles des variantes
const variants = {
  default: 'bg-background text-foreground hover:bg-background-button border focus:background-button active:background-button',
  primary:
    'bg-primary text-primary-foreground text-lg hover:bg-primary-accent hover:text-secondary-foreground dark:bg-primary-accent dark:hover:bg-primary focus:bg-primary-accent active:bg-primary-accent',
  secondary:
    'bg-secondary text-foreground hover:bg-secondary-accent hover:text-secondary-foreground dark:bg-secondary-accent dark:hover:bg-secondary dark:text-background dark:hover:text-foreground', 
  tag:
    'bg-background dark:bg-secondary-accent border-2 dark:border-1 border-secondary-accent dark:border-background dark:hover:border-secondary-accent text-sm max-lg:text-xs w-auto font-heading text-secondary-accent dark:text-secondary-foreground hover:bg-secondary-accent dark:hover:bg-background hover:text-background dark:hover:text-secondary-accent focus:bg-secondary-accent active:bg-secondary-accent focus:text-secondary-foreground active:text-secondary-foreground', 
};

// Styles des tailles
const sizes = {
  small:
    'px-5 py-1.5 ',
  medium: 'px-5 py-2.5',
  large: 'px-5 py-2.5',
};

// Définition du composant en fonction du type de lien
const Component: ButtonType = href ? 'a' : 'button';
---

<Component
  class={cn(baseStyles, variants[variant], sizes[size], className)}
  {href}
  {...rest}
>
  <slot />
</Component>
