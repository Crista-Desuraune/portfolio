---
import config from '../data/navigation.json';
import NavLink from './NavLink.astro';

const { primary } = config;

type LinkPrimaryType = {
  url: string;
  label: string;
};


---
<nav class="inset-x-4 ">
  <div
    class="hidden lg:flex text-primary-foreground gap-10"
  >
    {
        primary &&
        primary.map((item: LinkPrimaryType) => (
            <NavLink
                url={item.url}
                title={item.label}
            />
        ))
    }
  </div>
</nav>