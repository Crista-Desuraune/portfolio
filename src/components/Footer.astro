---
import configNav from "../data/navigation.json";
import configGeneral from "../data/infoGeneral.json";
import SocialNetworks from './SocialNetworks.astro';

const {footer} = configNav;
const { about } = configNav.posts;
---

<footer class="mt-15 font-heading">
    <div class="bg-secondary text-foreground py-5">
        <div class="justify-center container mx-auto text-start flex">
            <div class="flex flex-col px-10 py-5 border-r-2 border-secondary-accent self-center">
                <img src="/images/logo-crista-275.png" alt="logo-crista" class="w-40 h-auto my-5" />
            </div>
            <div class="flex flex-col px-10 py-5 border-r-2 border-secondary-accent">
                {footer.map((item) => (
                    <a href={item.url} class="hover:text-secondary-accent  duration-200 ease-in-out leading-5" aria-label={`Aller à ${item.label}`}>
                        {item.label}
                    </a>
                ))}
            </div>
            <div class="flex flex-col px-10 py-5 border-r-2 border-secondary-accent">
                {about.map((item) => (
                    <a href={item.url} class="hover:text-secondary-accent duration-200 ease-in-out leading-5" aria-label={`Aller à ${item.label}`}>
                        {item.label}
                    </a>
                ))}
            </div>
            <div class="flex flex-col px-10 py-5">
                <h2 class="font-bold">Suivez-moi !</h2>
                <SocialNetworks items={configGeneral.social} />
            </div>
            
        </div>
    </div>
  <div class="mx-auto text-center bg-secondary-accent text-secondary-foreground px-auto py-5">
    <p>&copy; 2025 Desuraune--Cocu Crista. Tout droit réservé.</p>
  </div>
</footer>