---
import { Icon } from "astro-icon/components";

const { items } = Astro.props;

type SocialItemType = {
    label: string,
    url: string,
    icon: string
}
---

{items && items.length > 0 && (
  <ul class="flex gap-2">
    {items.map(({ label, url, icon }: SocialItemType) => (
      <li>
        <a
          class="hover:text-primary text-2xl"
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          title={`Retrouvez-moi sur ${label}`}
          aria-label={`Retrouvez-moi sur ${label}`}
        >
          {icon ? <Icon name={icon} aria-hidden /> : label}
        </a>
      </li>
    ))}
  </ul>
)}
