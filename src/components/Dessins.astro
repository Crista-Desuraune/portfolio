---
import config from '../data/dessins.json'

const dessins = config;

type DessinsType = {
    img: string;
    alt: string;
};
---
<div class="columns-3 gap-7 mx-auto py-10">
    {
        dessins &&
        dessins.map((item: DessinsType) => (
            <div class="mb-7">
                <img class="w-72 rounded-lg" src={item.img} alt={item.alt} />
            </div>
        ))
    }
</div>