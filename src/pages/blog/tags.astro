---
import { getCollection } from 'astro:content';
import Button from '../../components/ui/Button.astro';

const posts = await getCollection('blog');

const allTags = Array.from(
  new Set(
    posts.flatMap(post => post.data.tags ?? [])
  )
);
---


<div class="grid max-sm:grid-cols-2 max-md:grid-cols-3  grid-cols-6 2xl:grid-cols-1 py-5 px-8 rounded-lg gap-1 mb-4">
  {allTags.map(tag => (
    <Button variant="tag" class="my-0 w-auto max-w-40 text-center content-center" size ="small" href={`/blog/tags/${tag}`}>
        {tag}
    </Button>
  ))}
</div>