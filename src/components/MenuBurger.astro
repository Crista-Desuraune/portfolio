---
import config from '../data/navigation.json';
import NavLink from './NavLink.astro';

const { primary } = config;

type LinkPrimaryType = {
  url: string;
  label: string;
};
const { id } = Astro.props;
--- 
<nav class="inset-x-4 w-64 top-0 z-3 left-0 fixed hidden" id={id}>
    <div
      class="text-primary-foreground bg-secondary h-screen lg:hidden text-2xl font-heading p-5 gap-10"
      id="nav"
    >
    <a
        class="font-base text-right hover:text-secondary-accent duration-200 ease-in-out" 
        id="close"
        aria-label="Ouvrir le menu principal">
        x
    </a>
      {
          primary &&
          primary.map((item: LinkPrimaryType) => (
              <NavLink
                  url={item.url}
                  title={item.label}
              />
          ))
      }
    </div>
</nav>
<script>
    const menuBurger = document.querySelector('#nav');
    const croix = document.querySelector('#close');
    if (menuBurger && croix) {
        croix.addEventListener('click', () => {
            menuBurger.classList.toggle('hidden');
        });
    }
</script>