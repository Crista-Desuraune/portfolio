---
import Button from './Button.astro';
const { cardsImage, cardsTitle, cardsDescription, cardsUrl } = Astro.props;
---
<div class=" flex flex-col gap-4 rounded-lg bg-background p-5 w-auto font-base border-1 drop-shadow-lg/20 border-primary-accent text-center">
  <div class="bg-primary-accent/10 border-1 drop-shadow-lg/20 border-primary-accent w-full h-32 rounded-lg">
    <img src={cardsImage} alt="image" class="h-full justify-self-center p-3">
    
  </div>

  <h2 class="text-foreground text-2xl font-bold font-heading"> {cardsTitle}</h2>

  <p class="font-base text-md line-clamp-2">
    {cardsDescription}
  </p>
  <Button variant="primary" size="small" class="mt-auto self-center" aria-label=`Voir le projet ${cardsTitle}` href={cardsUrl}>
    Voir
  </Button>
</div>