---
const { url, title } = Astro.props;
---
<div class="gap-5">
    <a
    href={url}
    >
        <span class="text-primary-foreground lg:text-lg text-2xl lg:py-full lg:hover:text-primary lg:focus:text-primary lg:active:text-primary focus:text-primary-accent active:text-primary-accent hover:text-primary-accent duration-200 ease-in-out"
            >{title}</span
    >
    </a>
</div>
