---
import Formulaire from '../components/Formulaire.astro';
import SocialNetworks from '../components/SocialNetworks.astro';
import configGeneral from "../data/infoGeneral.json";
import Layout from '../layouts/Layout.astro';

---

<Layout>
    <h1>Pour me contacter...</h1>
    <div class="flex max-lg:flex-col lg:gap-20 mx-auto w-auto mt-10 bg-background-button dark:bg-primary-accent/90 lg:px-20 px-5 lg:py-10 py-5 rounded-lg">
        <div class="flex flex-col gap-4  max-lg:mb-10 font-base dark:text-background text-foreground">
            <h2 class="font-heading text-2xl font-bold text-center">Mes coordonnées</h2>
            <div class="flex flex-col gap-2">
                <div class="flex gap-0.5">
                    <img src="/images/icon/appel-telephonique-noir.png" alt="telephone" class="size-5 dark:hidden">
                    <img src="/images/icon/appel-telephonique.png" alt="telephone" class="size-5 hidden dark:block">
                    <p>
                        : 06 23 01 77 18
                    </p>
                </div>
                <div class="flex gap-0.5">
                    <img src="/images/icon/enveloppe-noir.png" alt="email" class="size-5 dark:hidden">
                    <img src="/images/icon/enveloppe.png" alt="email" class="size-5 hidden dark:block">
                    <p>
                        : crista.desuraune@gmail.com
                    </p>
                </div>
            </div>
            <div class="flex flex-col gap-2">
                <h3 class="font-heading text-xl font-bold">Retrouvez moi ici !</h3>
                <SocialNetworks items={configGeneral.social} />
            </div>
        </div>
        <div class="gap-2 flex flex-col dark:text-background text-foreground">
           <h2 class="font-heading text-2xl font-bold text-center">Formulaire de contact</h2>
            <Formulaire />
        </div>
    </div>
    
    
</Layout>
