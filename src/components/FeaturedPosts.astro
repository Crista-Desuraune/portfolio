---
import Card from './ui/Card.astro';

import type { CardsType } from "../types";
import Button from './ui/Button.astro';

const { postIds, title, description, excludedIds, button} = Astro.props;

// Filtrer les posts pour exclure ceux présents dans excludedIds
const filteredPosts = excludedIds
  ? postIds.filter((post: CardsType) => !excludedIds.includes(post.url))
  : postIds;
---

{filteredPosts &&
<section>
    {title && <h2 class="text-foreground dark:text-background">{title}</h2>} 
    {description && <p class="text-foreground dark:text-background text-base font-base text-center mb-5">{description}</p>} 
    <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-5 py-5 grid-cols-1">
        {
            filteredPosts.map((item: CardsType) => (
                <Card
                    cardsTitle={item.label}
                    cardsDescription={item.description}
                    cardsUrl={item.url}
                    cardsImage={item.image}
                />
            ))
        }
    </div>
    <div class={`justify-self-center ${button? `block`:`hidden`} `}>
        <Button href="/projects" variant="secondary" size="small" class="inline-flex">Voir tous les projets</Button>
    </div>
    
</section>
}