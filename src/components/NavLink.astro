---
const { url, title } = Astro.props;
---
<div class="gap-5">
    <a
    href={url}
    >
        <span class="text-primary-foreground text-lg lg:py-full lg:hover:text-secondary lg:focus:text-secondary lg:active:text-secondary focus:text-secondary-accent active:text-secondary-accent hover:text-secondary-accent duration-200 ease-in-out"
            >{title}</span
    >
    </a>
</div>
