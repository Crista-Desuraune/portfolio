---
const { title, place, date, reverse } = Astro.props;
---
<div class={`${reverse ? 'text-end' : 'flex-row'} text-primary-foreground gap-10 h-auto pt-10 pb-8`}>
    <h3 class="font-heading font-bold uppercase text-lg">
        {title}
    </h3>
    <p class="font-heading font-bold text-base">
        <em>{place}</em>
    </p>
    <p class="font-heading text-sm font-bold">
        <em>{date}</em>
    </p>
    <ul class="font-base list-disc list-inside pl-2.5 mt-4">
        <slot/>
    </ul>
</div>

