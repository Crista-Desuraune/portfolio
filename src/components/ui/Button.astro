---
import { cn } from '../../lib/utils';

// Types
export type ButtonType = 'button' | 'a';

export type ButtonPropsType = {
  default?: string;
  variant?: 'default' | 'primary' | 'secondary';
  size?: 'small' | 'medium' | 'large';
  class?: string;
  href?: string;
};

// Récupération des props
const {
  variant = 'default',
  size = 'medium',
  class: className,
  href,
}: ButtonPropsType = Astro.props;

// Styles de base
const baseStyles =
  'cursor-pointer font-base bold text-lg block text-center rounded w-auto no-underline';

// Styles des variantes
const variants = {
  default: 'bg-background text-foreground hover:bg-primary-foreground border',
  primary:
    'bg-primary text-primary-foreground text-lg hover:bg-primary-accent hover:text-secondary-foreground',
  secondary:
    'bg-secondary text-foreground hover:bg-secondary-accent hover:text-secondary-foreground', 
};

// Styles des tailles
const sizes = {
  small:
    'px-5 py-2 ',
  medium: 'px-5 py-2.5',
  large: 'px-5 py-2.5',
};

// Définition du composant en fonction du type de lien
const Component: ButtonType = href ? 'a' : 'button';
---

<Component
  class={cn(baseStyles, variants[variant], sizes[size], className)}
  {href}
>
  <slot />
</Component>
