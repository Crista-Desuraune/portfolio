---
import Carousel from '../components/Carousel.astro';
import Section from '../components/Section.astro';
import Layout from '../layouts/Layout.astro';
---
<Layout>
    <Carousel dimensions="w-96">
            <img src="/images/rachid/rachid1.jpg" alt="carousel-rachid1" />
            <img src="/images/rachid/rachid2.jpg" alt="carousel-rachid2" />
            <img src="/images/rachid/rachid3.jpg" alt="carousel-rachid3" />
            <img src="/images/rachid/rachid4.jpg" alt="carousel-rachid4" /> 
            <img src="/images/rachid/rachid5.jpg" alt="carousel-rachid5" />
            <img src="/images/rachid/rachid6.jpg" alt="carousel-rachid6" />
            <img src="/images/rachid/rachid7.jpg" alt="carousel-rachid7" />
            <img src="/images/rachid/rachid8.jpg" alt="carousel-rachid8" />
    </Carousel>
    <Carousel dimensions="w-xl">
            <img src="/images/ces/ces1.png" alt="carousel-club-eco-st-sever1" />
            <img src="/images/ces/ces2.png" alt="carousel-club-eco-st-sever2" />
            <img src="/images/ces/ces3.png" alt="carousel-club-eco-st-sever3" />
            <img src="/images/ces/ces4.png" alt="carousel-club-eco-st-sever4" />
            <img src="/images/ces/ces5.png" alt="carousel-club-eco-st-sever5" />
            <img src="/images/ces/ces6.png" alt="carousel-club-eco-st-sever6" />
            <img src="/images/ces/ces7.png" alt="carousel-club-eco-st-sever7" />
            <img src="/images/ces/ces8.png" alt="carousel-club-eco-st-sever8" />
            <img src="/images/ces/ces9.png" alt="carousel-club-eco-st-sever9" />
            <img src="/images/ces/ces10.png" alt="carousel-club-eco-st-sever10" />
            <img src="/images/ces/ces11.png" alt="carousel-club-eco-st-sever11" />
            <img src="/images/ces/ces11.png" alt="carousel-club-eco-st-sever11" />
    </Carousel>
    <Section sideImg="/images/logo-crista-275.png" sideAlt="alt-image-logo">
        <h1 class="text-3xl font-bold mb-5">À propos de moi</h1>
        <p class="text-base text-foreground">
            Je suis un développeur web passionné par la création d'expériences numériques uniques. Mon parcours m'a permis d'acquérir une solide expertise dans le développement front-end et back-end, ainsi que dans la conception d'interfaces utilisateur intuitives.
        </p>
    </Section>
    <Section reverse={true} sideImg="/images/logo-handisup.png" sideAlt="alt-image-logo">
        <h1 class="text-3xl font-bold mb-5">À propos de moi</h1>
        <p class="text-base text-foreground">
            Je suis un développeur web passionné par la création d'expériences numériques uniques. Mon parcours m'a permis d'acquérir une solide expertise dans le développement front-end et back-end, ainsi que dans la conception d'interfaces utilisateur intuitives.
        </p>
    </Section>

</Layout>